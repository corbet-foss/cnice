{
  "name": "@corbet-labs/cnice",
  "version": "0.1.1",
  "description": "Formulaic correspondence phrases: German salutations and locale-specific valedictions (cnice.greet + cnice.farewell). No models, no I/O: same input always yields the same output. Mirrors the cnice Rust crate release line.",
  "license": "LGPL-3.0-only WITH LGPL-3.0-linking-exception",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbet-foss/cnice.git",
    "directory": "js/@corbet-labs/cnice"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSES/**/*"
  ],
  "scripts": {
    "prepack": "bun run build",
    "conformance": "bun ./scripts/conformance.mts",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "build": "bun ./scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "typescript": "6.0.3"
  },
  "module": "./dist/index.js",
  "unpkg": "./dist/browser.js",
  "jsdelivr": "./dist/browser.js",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/corbet-foss/cnice#readme",
  "bugs": {
    "url": "https://github.com/corbet-foss/cnice/issues"
  },
  "keywords": [
    "i18n",
    "correspondence",
    "typescript",
    "rust",
    "cnice"
  ]
}
